# 服务器环境变量模板
# 部署时复制到：/etc/blog-system/blog-system.env（由 systemd 的 EnvironmentFile 加载）
# 注意：这个 .example 文件只有占位符，但真实文件不要提交到仓库。
#
# 与 application-prod.yml 的对应关系：prod profile 下敏感项一律写 ${VAR}（无默认值），
# 缺失时启动即失败——所以「必须」标记的项少一个，服务就起不来。

# ===== 必须 =====
DB_PASSWORD=your_mysql_password
# JWT 签名密钥：至少 32 字符随机串（启动时有长度校验；用示例值会被拒绝）
JWT_SECRET=change_to_a_random_string_at_least_32_chars
# AI 能力（对话 / RAG / Agent）：阿里云百炼 API Key
ALIYUN_API_KEY=your_dashscope_api_key

# ===== GitHub 登录（必须，除非不用这个功能）=====
# 回调地址必须与 GitHub 应用后台登记的 Authorization callback URL 完全一致
GITHUB_OAUTH_CLIENT_ID=your_github_oauth_client_id
GITHUB_OAUTH_CLIENT_SECRET=your_github_oauth_client_secret
GITHUB_OAUTH_REDIRECT_URI=https://your-domain/api/auth/github/callback

# 前端地址：OAuth 登录成功后跳回这里。留空或写 localhost 会把线上用户跳到自己电脑
APP_FRONTEND_URL=https://your-domain

# ===== 按需 =====
# Redis 密码：Redis 设了密码就必填（留空 = 客户端不发 AUTH，适用于无密码 Redis）
REDIS_PASSWORD=

# ===== 可选（不设则用 application.yml 的默认值）=====
# 生成链模型 / 判断链模型（判断链建议绑一个稳定的模型，见 docs/agent/agent-judge-model-separation-design.md）
# AI_CHAT_MODEL=qwen3.7-flash
# AI_JUDGE_MODEL=qwen3.6-plus
# RAG rerank 工作空间：留空则 rerank 降级
# ALIYUN_WORKSPACE_ID=

# ===== 由阿里云 SDK 直读，不经过 Spring =====
# 变量名固定为 OSS_ACCESS_KEY_ID / OSS_ACCESS_KEY_SECRET（见 aliyun-sdk-oss 的
# EnvironmentVariableCredentialsProvider），只有上传文件时才需要
OSS_ACCESS_KEY_ID=your_oss_access_key_id
OSS_ACCESS_KEY_SECRET=your_oss_access_key_secret
